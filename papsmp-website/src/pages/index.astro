<BaseLayout title={page.title} description={page.description}><SiteHeader /><main id="main" class="home-page"><Hero /><ServerStrip /><PhasePanel /><CorruptedHeart /><ClaimDefense /><PackHighlights /><JoinAlpha /><DownloadsVip /><Community /><VipShopDemo /><Faq /></main><SiteFooter /></BaseLayout>
