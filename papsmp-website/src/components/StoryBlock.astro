---
import copy from '../content/editor/story-block.json';
---
<section class="section section-story" aria-labelledby="story-title"><div class="container section-block story-block"><div class="section-heading story-heading"><p class="kicker">{copy.texts.text_1}</p><h2 id="story-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2><p>{copy.texts.text_2}</p></div><div class="story-layout story-card-grid"><article class="story-card peace"><img class="story-card-image" src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="1672" height="941" loading="lazy" /><span class="phase-label">{copy.texts.beschriftung_1}</span><h3>{copy.texts.titel_3}</h3><p>{copy.texts.text_3}</p></article><article class="story-card purge"><img class="story-card-image" src={copy.images.bild_2} alt={copy.images.bild_2_alt} width="1671" height="941" loading="lazy" /><span class="phase-label">{copy.texts.beschriftung_2}</span><h3>{copy.texts.titel_4}</h3><p>{copy.texts.text_4}</p></article><article class="story-card dawn"><img class="story-card-image" src={copy.images.bild_3} alt={copy.images.bild_3_alt} width="1672" height="941" loading="lazy" /><span class="phase-label">{copy.texts.beschriftung_3}</span><h3>{copy.texts.titel_5}</h3><p>{copy.texts.text_5}</p></article></div><div class="emote-row" aria-label="PAP-Emotes"><span>{copy.texts.beschriftung_4}</span><img src={copy.images.bild_4} alt={copy.images.bild_4_alt} width="128" height="128" loading="lazy" /><picture><source srcset={copy.images.animation_1} media="(prefers-reduced-motion: no-preference)" /><img src={copy.images.bild_5} alt={copy.images.bild_5_alt} width="128" height="128" loading="lazy" /></picture><img src={copy.images.bild_6} alt={copy.images.bild_6_alt} width="128" height="128" loading="lazy" /></div></div></section>
