---
interface Props { name: string; alt: string; eager?: boolean; }
const {name,alt,eager=false}=Astro.props;
---
<img class="alpha-art" src={`/alpha-v2/${name}-960.webp`} srcset={`/alpha-v2/${name}-640.webp 640w, /alpha-v2/${name}-960.webp 960w, /alpha-v2/${name}-1600.webp 1600w`} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 90vw, 600px" width="1600" height="900" alt={alt} loading={eager?'eager':'lazy'} decoding="async" />
