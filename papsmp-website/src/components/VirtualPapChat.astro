<div class="pap-chat" data-pap-chat>
  <section
    class="pap-chat-panel"
    id="pap-chat-panel"
    data-chat-panel
    role="dialog"
    aria-labelledby="pap-chat-title"
    aria-modal="false"
    hidden
  >
    <header class="pap-chat-header">
      <img src="/emotes/pap-curious.png" alt="" width="40" height="40" />
      <div>
        <h2 id="pap-chat-title">PAP</h2>
        <p>Virtueller Website-Assistent</p>
      </div>
      <button class="pap-chat-close" data-chat-close type="button" aria-label="Chat schließen">×</button>
    </header>

    <div class="pap-chat-messages" data-chat-messages role="log" aria-live="polite" aria-relevant="additions text">
      <p class="pap-chat-message pap-chat-message-assistant">
        Hey! Ich bin PAP, der virtuelle Website-Assistent. Frag mich zum Server, zur Alpha oder zu den Angeboten.
      </p>
    </div>

    <p class="pap-chat-disclosure">
      KI-Chat: Deine Nachricht wird zur Antwortgenerierung an OpenAI übertragen. Bitte keine persönlichen Daten senden.
    </p>

    <form class="pap-chat-form" data-chat-form>
      <label class="pap-chat-sr-only" for="pap-chat-input">Nachricht an PAP</label>
      <textarea
        id="pap-chat-input"
        name="message"
        data-chat-input
        rows="1"
        maxlength="1000"
        placeholder="Frag PAP …"
        required
      ></textarea>
      <button class="pap-chat-send" data-chat-send type="submit" aria-label="Nachricht senden">
        <span aria-hidden="true">↑</span>
      </button>
    </form>
    <p class="pap-chat-status" data-chat-status role="status" aria-live="polite"></p>
  </section>

  <button
    class="pap-chat-launch"
    data-chat-toggle
    type="button"
    aria-expanded="false"
    aria-controls="pap-chat-panel"
  >
    <img src="/emotes/pap-curious.png" alt="" width="32" height="32" />
    <span>Frag PAP</span>
  </button>
</div>

<script>
  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  const root = document.querySelector<HTMLElement>('[data-pap-chat]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-chat-toggle]');
  const close = root?.querySelector<HTMLButtonElement>('[data-chat-close]');
  const panel = root?.querySelector<HTMLElement>('[data-chat-panel]');
  const form = root?.querySelector<HTMLFormElement>('[data-chat-form]');
  const input = root?.querySelector<HTMLTextAreaElement>('[data-chat-input]');
  const send = root?.querySelector<HTMLButtonElement>('[data-chat-send]');
  const list = root?.querySelector<HTMLElement>('[data-chat-messages]');
  const status = root?.querySelector<HTMLElement>('[data-chat-status]');
  const history: ChatMessage[] = [];

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) input?.focus();
    else toggle.focus();
  }

  function addMessage(role: ChatMessage['role'], content: string) {
    if (!list) return;
    const message = document.createElement('p');
    message.className = `pap-chat-message pap-chat-message-${role}`;
    message.textContent = content;
    list.append(message);
    list.scrollTop = list.scrollHeight;
  }

  toggle?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  close?.addEventListener('click', () => setOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const content = input?.value.trim();
    if (!content || !input || !send || !status) return;

    input.value = '';
    input.disabled = true;
    send.disabled = true;
    status.textContent = 'PAP denkt nach …';
    addMessage('user', content);
    history.push({ role: 'user', content });

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history.slice(-10) }),
      });
      const result = await response.json().catch(() => ({})) as { answer?: string; error?: string };
      if (!response.ok || !result.answer) {
        throw new Error(result.error || 'PAP ist gerade nicht erreichbar. Versuch es bitte später erneut.');
      }

      history.push({ role: 'assistant', content: result.answer });
      addMessage('assistant', result.answer);
      status.textContent = '';
    } catch (error) {
      history.pop();
      status.textContent = error instanceof Error
        ? error.message
        : 'PAP ist gerade nicht erreichbar. Versuch es bitte später erneut.';
    } finally {
      input.disabled = false;
      send.disabled = false;
      input.focus();
    }
  });
</script>