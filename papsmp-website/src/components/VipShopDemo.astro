---
import copy from '../content/editor/vip-shop-demo.json';
---
<section id="vip-shop" class="section section-vip-demo" aria-labelledby="vip-shop-title">
  <div class="container section-block vip-demo-block">
    <div class="section-heading">
      <p class="kicker">{copy.texts.text_1}</p>
      <h2 id="vip-shop-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2>
      <p>{copy.texts.text_2}</p>
    </div>

    <article class="shop-vip" aria-labelledby="pap-vip-title">
      <div class="shop-vip-art">
        <picture>
          <source srcset={copy.images.animation_1} media="(prefers-reduced-motion: no-preference)" />
          <img src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="512" height="512" loading="lazy" />
        </picture>
        <span>{copy.texts.beschriftung_1}<br />{copy.texts.beschriftung_2}</span>
      </div>
      <div class="shop-vip-copy">
        <span class="shop-label">{copy.texts.beschriftung_3}</span>
        <h3 id="pap-vip-title">{copy.texts.titel_3}</h3>
        <p>{copy.texts.text_3}</p>
        <ul>
          <li>{copy.texts.text_4}</li>
          <li>{copy.texts.text_5}</li>
          <li>{copy.texts.text_6}</li>
          <li>{copy.texts.text_7}</li>
        </ul>
      </div>
      <div class="shop-vip-price">
        <p class="shop-price">{copy.texts.text_8}<span>{copy.texts.beschriftung_4}</span></p>
        <span class="shop-state">{copy.texts.beschriftung_5}</span>
        <a class="shop-info" href="https://discord.gg/hxgnJNTp4J" target="_blank" rel="noopener noreferrer">{copy.texts.beschriftung_6}</a>
      </div>
    </article>

    <div class="shop-packages" aria-label="Einzelne Shop-Pakete">
      <article class="shop-package">
        <div class="shop-package-top"><svg viewBox="0 0 64 64" aria-hidden="true"><path fill="#ad7bef" d="m32 3 21 19-6 27-15 12-15-12-6-27Z"/><path fill="#e6d3ff" d="M32 3 11 22l21 10Z"/><path fill="#8051be" d="m32 32 21-10-6 27-15 12Z"/></svg><span class="shop-label">{copy.texts.beschriftung_7}</span></div>
        <h3>{copy.texts.titel_4}</h3>
        <p>{copy.texts.text_9}</p>
        <p class="shop-price">{copy.texts.text_10}<span>{copy.texts.beschriftung_8}</span></p>
        <span class="shop-state">{copy.texts.beschriftung_9}</span>
      </article>
      <article class="shop-package">
        <div class="shop-package-top"><svg viewBox="0 0 64 64" aria-hidden="true"><path fill="#f4bf68" d="M10 6h28v28H28v24H18V34h-8Zm9 9v10h10V15Zm9 24h19v9H28Zm0 13h12v6H28Z"/></svg><span class="shop-label">{copy.texts.beschriftung_10}</span></div>
        <h3>{copy.texts.titel_5}</h3>
        <p>{copy.texts.text_11}</p>
        <p class="shop-price">{copy.texts.text_12}<span>{copy.texts.beschriftung_11}</span></p>
        <span class="shop-state">{copy.texts.beschriftung_12}</span>
      </article>
    </div>

    <details class="shop-details">
      <summary>{copy.texts.beschriftung_13}</summary>
      <p>{copy.texts.text_13}</p>
      <p>{copy.texts.text_14}</p>
      <p>{copy.texts.text_15} <a href="https://pap-vip-commerce.pap-vip-smp.workers.dev/vip" target="_blank" rel="noopener noreferrer">{copy.texts.beschriftung_14}</a> {copy.texts.text_16}</p>
    </details>
  </div>
</section>

<style>
  .shop-vip,.shop-package{border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .shop-vip{display:grid;grid-template-columns:minmax(150px,.7fr) minmax(0,1.35fr) minmax(190px,.75fr);gap:1.6rem;align-items:center;padding:1.8rem;background:linear-gradient(115deg,#3a2a27,#181224 54%);border-color:rgba(244,191,104,.4)}
  .shop-vip-art{text-align:center}
  .shop-vip-art img{display:block;width:100%;height:auto;max-width:220px;margin:auto}
  .shop-vip-art>span{display:block;color:var(--muted);font-size:.78rem;line-height:1.6}
  .shop-label{display:block;color:#d5b68a;font-size:.7rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}
  .shop-vip h3,.shop-package h3{font-family:var(--font-display,'Space Grotesk',sans-serif);font-size:clamp(1.4rem,2.5vw,2rem);line-height:1.3;margin:.65rem 0}
  .shop-vip-copy>p,.shop-package>p:not(.shop-price){font-size:.9rem;color:var(--muted);line-height:1.7}
  .shop-vip ul{padding-left:1.15rem;line-height:1.7;font-size:.9rem;margin:1rem 0 0}
  .shop-vip li+li{margin-top:.3rem}
  .shop-vip li::marker{color:#f4bf68}
  .shop-vip-price{display:flex;flex-direction:column;gap:.85rem;align-items:flex-start;border-left:1px solid var(--line);padding-left:1.4rem}
  #vip-shop .shop-price{font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,3.5vw,3rem);font-weight:700;color:#f4bf68;line-height:1.15;margin:0}
  .shop-price span{display:block;font-family:Inter,sans-serif;font-size:.8rem;font-weight:400;color:var(--muted);line-height:1.6;margin-top:.55rem}
  .shop-state{display:inline-block;font-size:.7rem;font-weight:600;color:#dbc797;border:1px solid rgba(244,191,104,.25);background:rgba(244,191,104,.07);padding:.55rem .7rem;border-radius:6px}
  .shop-info{font-size:.8rem;line-height:1.6;color:#f4bf68;text-decoration:underline;text-underline-offset:4px}
  .shop-packages{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1.25rem}
  .shop-package{padding:1.6rem;background:linear-gradient(135deg,#2b203a,#181224);display:flex;flex-direction:column;align-items:flex-start}
  .shop-package-top{display:flex;align-items:center;gap:.7rem}
  .shop-package-top svg{width:38px;height:38px}
  #vip-shop .shop-package .shop-price{margin-top:auto;padding-top:.8rem;font-size:2rem}
  .shop-package .shop-state{margin-top:1rem}
  .shop-details{margin-top:1.4rem;border-top:1px solid var(--line);padding-top:1.15rem;color:var(--muted);font-size:.85rem;line-height:1.8}
  .shop-details summary{cursor:pointer;color:#e2d8ef;font-weight:600}
  .shop-details p{margin:.8rem 0 0}
  .shop-details a{color:#f4bf68;text-decoration:underline}
  .shop-info:focus-visible,.shop-details summary:focus-visible,.shop-details a:focus-visible{outline:2px solid #f4bf68;outline-offset:5px}
  @media(max-width:1000px){.shop-vip{grid-template-columns:150px minmax(0,1fr)}.shop-vip-price{grid-column:2;border-left:0;border-top:1px solid var(--line);padding:1rem 0 0}}
  @media(max-width:640px){.shop-vip{grid-template-columns:minmax(0,1fr);padding:1.25rem;gap:1rem}.shop-vip-art img{max-width:155px}.shop-vip-art>span{display:none}.shop-vip-price{grid-column:auto}.shop-packages{grid-template-columns:minmax(0,1fr)}.shop-package{padding:1.25rem}.shop-vip h3,.shop-package h3{font-size:1.6rem}}
</style>
