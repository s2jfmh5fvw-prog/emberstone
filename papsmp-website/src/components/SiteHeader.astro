---
import SocialLinks from './SocialLinks.astro';
const compact = Astro.url.pathname !== '/';
const items = [['/#konzept','Spielprinzip'],['/infobuch/','Infobuch'],['/regelbuch/','Regelbuch'],['/#crossplay','Editionen'],['/#zugang','Alpha'],['/#community','Community'],['/#downloads','Downloads'],['/shop/','Shop']];
---
<header class:list={['site-header', 'classic-header', {'classic-header--compact': compact}]}>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <div class="header-inner">
    <div class="brand-stack">
      <a class="wordmark" href="/" aria-label="PAP SMP Startseite"><img class="header-brand-logo" src="/alpha-v2/brand-logo.webp" alt="PAP SMP" width="512" height="512" fetchpriority="high" decoding="async" /></a>
      <a class="header-alpha-message" href="https://discord.gg/hxgnJNTp4J" target="_blank" rel="noopener noreferrer">Alpha-Infos auf Discord</a>
      <p class="kicker header-alpha-kicker">MINECRAFT SURVIVAL · ALPHA</p>
    </div>
  </div>
</header>
<div class="sticky-nav">
  <div class="site-nav-inner">
    <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-nav"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
    <nav id="site-nav" class="site-navigation" aria-label="Hauptnavigation">
      <div class="site-nav-links">
        <div class="nav-list">{items.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}><span class="site-nav-link-text">{label}</span></a>)}</div>
        <div class="site-nav-footer">
          <p class="site-nav-footer-tagline">Peace &amp; Purge · Minecraft-Survival in der Alpha</p>
          <div class="site-nav-footer-links">
            <a href="/kontakt/"><span class="site-nav-link-text">Kontakt</span></a>
            <a href="/impressum/"><span class="site-nav-link-text">Impressum</span></a>
            <a href="/datenschutz/"><span class="site-nav-link-text">Datenschutz</span></a>
            <a href="/#main"><span class="site-nav-link-text">Zurück nach oben ↑</span></a>
          </div>
          <SocialLinks footer />
          <p class="site-nav-footer-credit">Created by <a href="https://www.twitch.tv/yuuh92" target="_blank" rel="noopener noreferrer">yuuh92</a></p>
        </div>
      </div>
    </nav>
  </div>
</div>
<SocialLinks />
<noscript>
  <style>
    @media (max-width: 800px) {
      .menu-toggle {
        display: none !important;
      }
      #site-nav {
        display: block !important;
        position: static !important;
        inset: auto !important;
        width: 100% !important;
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        transform: none !important;
        visibility: visible !important;
        -webkit-backdrop-filter: none !important;
        backdrop-filter: none !important;
      }
      .site-nav-links {
        display: flex !important;
        flex-direction: column !important;
      }
      .site-nav-footer {
        display: grid !important;
      }
    }
  </style>
</noscript>
<script>
  document.documentElement.classList.add('has-js');
  const setupDocument = document as Document & { __papHeaderController?: AbortController };
  const header = document.querySelector('.site-header') as HTMLElement | null;
  const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null; const nav = document.querySelector('#site-nav') as HTMLElement | null;
  const stickyNav = document.querySelector('.sticky-nav') as HTMLElement | null;
  const scrollCollapsePoint = 96;
  const isMobileMenu = () => window.innerWidth <= 800;
  const syncNavState = (currentToggle = toggle, currentNav = nav) => {
    if (!currentNav) return;
    const open = currentToggle?.getAttribute('aria-expanded') === 'true';
    const collapsed = isMobileMenu() || window.scrollY > scrollCollapsePoint;
    const hidden = collapsed && !open;
    currentNav.setAttribute('aria-hidden', String(hidden));
    currentNav.inert = hidden;
  };
  const close = () => { if (!toggle || !nav) return; toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Menü öffnen'); nav.classList.remove('is-open'); syncNavState(); };
  const syncScrollState = () => {
    const scrolled = window.scrollY > scrollCollapsePoint;
    if (scrolled && toggle?.getAttribute('aria-expanded') === 'true') close();
    stickyNav?.classList.toggle('is-scrolled', scrolled);
    if (!isMobileMenu() && !scrolled && toggle?.getAttribute('aria-expanded') === 'true') close();
    syncNavState();
  };
  if (header && nav && toggle && header.dataset.bound !== 'true') {
    setupDocument.__papHeaderController?.abort();
    const controller = new AbortController();
    const { signal } = controller;
    setupDocument.__papHeaderController = controller;
    header.dataset.bound = 'true';
    toggle.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen'); nav.classList.toggle('is-open', open); syncNavState(); }, { signal });
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', close, { signal }));
    window.addEventListener('scroll', syncScrollState, { passive: true, signal });
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      const activeToggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
      const activeNav = document.querySelector('#site-nav') as HTMLElement | null;
      if (!activeToggle || !activeNav) return;
      if (activeToggle.getAttribute('aria-expanded') !== 'true') return;
      activeToggle.setAttribute('aria-expanded', 'false');
      activeToggle.setAttribute('aria-label', 'Menü öffnen');
      activeNav.classList.remove('is-open');
      syncNavState(activeToggle, activeNav);
      activeToggle.focus();
    }, { signal });
    window.addEventListener('resize', () => {
      const activeToggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
      const activeNav = document.querySelector('#site-nav') as HTMLElement | null;
      if (window.innerWidth > 800) {
        activeToggle?.setAttribute('aria-expanded', 'false');
        activeToggle?.setAttribute('aria-label', 'Menü öffnen');
        activeNav?.classList.remove('is-open');
      }
      syncScrollState();
    }, { signal });
  }
  syncScrollState();
</script>
