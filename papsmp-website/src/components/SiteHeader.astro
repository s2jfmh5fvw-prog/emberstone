---
const items = [['konzept','Konzept'],['features','Features'],['crossplay','Crossplay'],['alpha','Alpha'],['community','Community'],['faq','FAQ']];
---
<header class="site-header">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <div class="header-inner">
    <span class="header-spacer" aria-hidden="true"></span>
    <div class="brand-stack">
      <a class="wordmark" href="/" aria-label="PAP SMP Startseite"><img class="header-brand-logo" src="/brand/pap_smp_logo_duality_loop.webp" alt="PAP SMP" width="512" height="512" /></a>
      <a class="header-alpha-message" href="https://discord.gg/hxgnJNTp4J" target="_blank" rel="noreferrer">Alpha-Anmeldung offen</a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-nav"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
    <nav id="site-nav" aria-label="Hauptnavigation"><div class="nav-list">{items.map(([href,label]) => <a href={`#${href}`}>{label}</a>)}</div><a class="button button-small" href="https://discord.gg/hxgnJNTp4J" target="_blank" rel="noreferrer">Alpha-Anmeldung ↗</a></nav>
  </div>
</header>
<noscript>
  <style>
    @media (max-width: 700px) {
      #site-nav {
        display: block !important;
        position: static !important;
        padding-top: 0.5rem !important;
        box-shadow: none !important;
      }
    }
  </style>
</noscript>
<script>
  document.documentElement.classList.add('has-js');
  const setupDocument = document as Document & { __papHeaderController?: AbortController };
  const header = document.querySelector('.site-header') as HTMLElement | null;
  const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null; const nav = document.querySelector('#site-nav') as HTMLElement | null;
  const isMobileMenu = () => window.innerWidth <= 700;
  const syncNavState = (currentToggle = toggle, currentNav = nav) => {
    if (!currentNav) return;
    const open = currentToggle?.getAttribute('aria-expanded') === 'true';
    if (!isMobileMenu()) {
      currentNav.removeAttribute('aria-hidden');
      return;
    }
    currentNav.setAttribute('aria-hidden', String(!open));
  };
  const close = () => { if (!toggle || !nav) return; toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Menü öffnen'); nav.classList.remove('is-open'); syncNavState(); };
  if (header && nav && toggle && header.dataset.bound !== 'true') {
    setupDocument.__papHeaderController?.abort();
    const controller = new AbortController();
    const { signal } = controller;
    setupDocument.__papHeaderController = controller;
    header.dataset.bound = 'true';
    toggle.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen'); nav.classList.toggle('is-open', open); syncNavState(); }, { signal });
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', close, { signal }));
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      const activeToggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
      const activeNav = document.querySelector('#site-nav') as HTMLElement | null;
      if (!activeToggle || !activeNav) return;
      activeToggle.setAttribute('aria-expanded', 'false');
      activeToggle.setAttribute('aria-label', 'Menü öffnen');
      activeNav.classList.remove('is-open');
      syncNavState(activeToggle, activeNav);
      activeToggle.focus();
    }, { signal });
    window.addEventListener('resize', () => {
      const activeToggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
      const activeNav = document.querySelector('#site-nav') as HTMLElement | null;
      syncNavState(activeToggle, activeNav);
    }, { signal });
  }
  syncNavState();
</script>
