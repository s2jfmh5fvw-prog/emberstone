---
const items = [['konzept','Konzept'],['features','Features'],['crossplay','Crossplay'],['alpha','Alpha'],['community','Community'],['faq','FAQ']];
---
<header class="site-header">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="PAP SMP Startseite"><img src="/brand/pap_monogram.png" alt="" /><span>PAP SMP</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span>Menü</span><i></i></button>
    <nav id="site-nav" aria-label="Hauptnavigation"><div class="nav-list">{items.map(([href,label]) => <a href={`#${href}`}>{label}</a>)}</div><a class="button button-small" href="https://discord.gg/hxgnJNTp4J" target="_blank" rel="noreferrer">Early Whitelist ↗</a></nav>
  </div>
</header>
<script>
  const toggle = document.querySelector('.menu-toggle'); const nav = document.querySelector('#site-nav');
  const close = () => { toggle?.setAttribute('aria-expanded','false'); nav?.classList.remove('is-open'); };
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); });
  nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { close(); (toggle as HTMLButtonElement | null)?.focus(); } });
</script>
