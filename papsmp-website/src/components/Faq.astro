---
import { faqs } from '../data/faq';
---
<section id="faq" class="section section-faq" aria-labelledby="faq-title"><div class="container section-block faq-grid faq-block"><div><p class="kicker">Noch Fragen?</p><h2 id="faq-title">Kurz und<br /><em>ehrlich.</em></h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span>＋</span></summary><p>{answer}</p></details>)}</div></div></section>
