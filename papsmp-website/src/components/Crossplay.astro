---
import copy from '../content/editor/crossplay.json';
---
<section id="crossplay" class="section section-crossplay" aria-labelledby="crossplay-title"><div class="container section-block crossplay-block"><div class="crossplay-grid"><div class="crossplay-copy"><p class="kicker">{copy.texts.text_1}</p><h2 id="crossplay-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2><p>{copy.texts.text_2}</p><div class="platforms" aria-label="Plattformstatus"><span class="platform-ready">{copy.texts.beschriftung_1}</span><span class="platform-testing">{copy.texts.beschriftung_2}</span><span class="platform-testing">{copy.texts.beschriftung_3}</span></div><div class="server-address"><span>{copy.texts.beschriftung_4}</span><strong>{copy.texts.beschriftung_5}</strong></div></div><div class="scene-panel"><img src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="1672" height="941" loading="lazy" /><div class="scene-panel-content"><span class="block-label">{copy.texts.beschriftung_6}</span><p>{copy.texts.text_3}</p></div></div></div></div></section>
