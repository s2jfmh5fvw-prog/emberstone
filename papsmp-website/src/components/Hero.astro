---
import copy from '../content/editor/hero.json';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title"><span class="hero-title-peace">{copy.texts.titel_1}</span><br /><em class="hero-title-purge">{copy.texts.titel_2}</em></h1>
      <p class="hero-lede">{copy.texts.text_1}</p>
      <div class="hero-actions"><a class="text-link" href="#konzept">{copy.texts.beschriftung_1} <span>↓</span></a></div>
    </div>
    <div class="hero-art"><div class="hero-art-frame" tabindex="0" aria-label="PAP begrüßen"><div class="hero-art-stage">
      <img class="hero-art-base" src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="512" height="512" decoding="async" />
      <picture class="hero-art-hover"><source srcset={copy.images.animation_1} media="(prefers-reduced-motion: no-preference)" /><img src={copy.images.bild_2} alt={copy.images.bild_2_alt} width="512" height="512" decoding="async" /></picture>
    </div></div></div>
  </div>
</section>

<style>
  .hero-art-stage { transform: scale(0.85); transform-origin: center; }
  .hero-art-base { display: block; opacity: 1; transition: opacity 180ms ease; }
  .hero-art-frame:hover .hero-art-base,
  .hero-art-frame:focus-within .hero-art-base { display: block; opacity: 0; }
  .hero-art-frame:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; border-radius: 12px; }
  @media (prefers-reduced-motion: reduce) {
    .hero-art-base { transition: none; }
    .hero-art-frame:hover .hero-art-base,
    .hero-art-frame:focus-within .hero-art-base { opacity: 1; }
  }
</style>
