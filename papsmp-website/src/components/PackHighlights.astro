---
import cards from '../content/editor/companions.json';
import copy from '../content/editor/pack-highlights.json';
const companions = cards.items;
---
<section id="pack-motive" class="section" aria-labelledby="pack-motive-title">
  <div class="container section-block pack-highlights">
    <div class="section-heading"><p class="kicker">{copy.texts.text_1}</p><h2 id="pack-motive-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2><p>{copy.texts.text_2}</p></div>
    <div class="motif-grid">
      {companions.map(pet => <article class="motif-card"><img src={pet.src} alt={`${pet.name} – Modellmotiv des PAP-Packs`} width="96" height="96" loading="lazy" /><h3>{pet.name}</h3><p>{pet.text}</p></article>)}
    </div>
    <p class="motif-note">{copy.texts.text_3}</p>
    <div class="motif-grid motif-items">
      <article class="motif-card"><img src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="96" height="96" loading="lazy" /><h3>{copy.texts.titel_3}</h3><p>{copy.texts.text_4}</p></article>
      <article class="motif-card"><img src={copy.images.bild_2} alt={copy.images.bild_2_alt} width="96" height="96" loading="lazy" /><h3>{copy.texts.titel_4}</h3><p>{copy.texts.text_5}</p></article>
      <article class="motif-card"><img src={copy.images.bild_3} alt={copy.images.bild_3_alt} width="96" height="96" loading="lazy" /><h3>{copy.texts.titel_5}</h3><p>{copy.texts.text_6}</p></article>
    </div>
    <details class="motif-recipes"><summary>{copy.texts.beschriftung_1}</summary><p>{copy.texts.text_7}</p><dl><div><dt>{copy.texts.beschriftung_2}</dt><dd>{copy.texts.text_8}</dd></div><div><dt>{copy.texts.beschriftung_3}</dt><dd>{copy.texts.text_9}</dd></div></dl><p>{copy.texts.text_10} <a href="#availability-title">{copy.texts.beschriftung_4}</a>.</p></details>
  </div>
</section>
<style>
  .pack-highlights { display:grid; gap:1.2rem; }
  .pack-highlights .section-heading { margin-bottom:0; }
  .motif-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .motif-card { padding:1.2rem; border:1px solid var(--line); border-top:2px solid var(--peace); border-radius:8px; background:rgba(24,18,36,.8); }
  .motif-card img { float:right; width:96px; height:96px; margin:-.3rem -.3rem .3rem .6rem; object-fit:contain; image-rendering:pixelated; }
  .motif-card h3 { margin:.4rem 0 .8rem; }
  .motif-card p { margin:0; clear:both; }
  .motif-items .motif-card { border-top-color:var(--purge); }
  .motif-note { margin:0; font-size:.85rem; color:var(--muted); }
  .motif-recipes { border:1px solid var(--line); border-radius:8px; padding:1rem 1.2rem; }
  .motif-recipes summary { cursor:pointer; font-weight:600; }
  .motif-recipes dl { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .motif-recipes dt { color:var(--peace); font-weight:600; }
  .motif-recipes dd { margin:.4rem 0 0; }
  .motif-recipes a { color:var(--peace); text-decoration:underline; }
  @media(max-width:800px) { .motif-grid { grid-template-columns:1fr; } .motif-card { display:grid; grid-template-columns:minmax(0,1fr) 80px; align-items:center; gap:.7rem; } .motif-card img { float:none; grid-column:2; grid-row:1; width:80px; height:80px; margin:0; } .motif-card h3 { grid-column:1; grid-row:1; margin:0; } .motif-card p { grid-column:1 / -1; clear:both; } }
  @media(max-width:560px) { .motif-recipes dl { grid-template-columns:1fr; } }
</style>
