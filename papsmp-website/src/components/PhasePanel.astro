---
import copy from '../content/editor/phase-panel.json';
---
<section id="konzept" class="section section-concept" aria-labelledby="concept-title"><div class="container section-block phase-block">
  <div class="section-heading"><p class="kicker">{copy.texts.text_1}</p><h2 id="concept-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2><p>{copy.texts.text_2}</p></div>
  <div class="phase-grid"><article class="phase-card peace"><picture><source srcset={copy.images.animation_1} media="(prefers-reduced-motion: no-preference)" /><img class="phase-sigil" src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="1024" height="1024" /></picture><div><span class="phase-label">{copy.texts.beschriftung_1}</span><h3>{copy.texts.titel_3}</h3><p>{copy.texts.text_3}</p><ul><li>{copy.texts.text_4}</li><li>{copy.texts.text_5}</li><li>{copy.texts.text_6}</li></ul><div class="phase-emote-tray" aria-label="Peace-Emote"><img src={copy.images.bild_2} alt={copy.images.bild_2_alt} width="128" height="128" loading="lazy" /></div></div></article><article class="phase-card purge"><picture><source srcset={copy.images.animation_2} media="(prefers-reduced-motion: no-preference)" /><img class="phase-sigil" src={copy.images.bild_3} alt={copy.images.bild_3_alt} width="1024" height="1024" /></picture><div><span class="phase-label">{copy.texts.beschriftung_2}</span><h3>{copy.texts.titel_4}</h3><p>{copy.texts.text_7}</p><ul><li>{copy.texts.text_8}</li><li>{copy.texts.text_9}</li><li>{copy.texts.text_10}</li></ul><div class="phase-emote-tray" aria-label="Purge-Emote"><img src={copy.images.bild_4} alt={copy.images.bild_4_alt} width="128" height="128" loading="lazy" /></div></div></article></div>
</div></section>
