---
import { features } from '../data/features';
---
<section id="features" class="section section-features" aria-labelledby="features-title"><div class="container section-block feature-block"><div class="section-heading row-heading"><div><p class="kicker">PAP SMP auf einen Blick</p><h2 id="features-title">Drei Fakten.<br /><em>Klarer Stand.</em></h2></div><p>Spielprinzip, Plattformen und Alpha-Zugang: die wichtigsten Infos kompakt.</p></div><div class="feature-grid">{features.map((feature, index) => <article class="feature-card"><span class="feature-number">0{index + 1}</span><img class="feature-emote" src={feature.emote.src} alt={feature.emote.alt} width="128" height="128" loading="lazy" /><span class="phase-label">{feature.eyebrow}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></div></section>
