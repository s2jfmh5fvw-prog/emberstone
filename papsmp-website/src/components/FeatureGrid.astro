---
import copy from '../content/editor/feature-grid.json';
import { features } from '../data/features';
---
<section id="features" class="section section-features" aria-labelledby="features-title"><div class="container section-block feature-block"><div class="section-heading row-heading"><div><p class="kicker">{copy.texts.text_1}</p><h2 id="features-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2></div><p>{copy.texts.text_2}</p></div><div class="feature-grid">{features.map((feature, index) => <article class="feature-card"><span class="feature-number">0{index + 1}</span><img class="feature-emote" src={feature.emote.src} alt={feature.emote.alt} width="128" height="128" loading="lazy" /><span class="phase-label">{feature.eyebrow}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></div></section>
