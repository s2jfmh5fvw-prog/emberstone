---
import copy from '../content/editor/downloads-vip.json';
import { packRelease, packSize } from '../data/pack-release';
---

<section class="section section-availability" aria-labelledby="availability-title">
  <div class="container section-block availability-block">
    <div class="section-heading">
      <p class="kicker">{copy.texts.text_1} {packRelease.label}</p>
      <h2 id="availability-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2>
      <p>{copy.texts.text_2} {packRelease.revision}.</p>
    </div>

    <div class="availability-grid">
      <a class="download-card download-card-active" href={packRelease.java.url} download>
        <span class="availability-icon">↓</span>
        <span class="phase-label">{copy.texts.beschriftung_1}</span>
        <h3>{copy.texts.titel_3} {packRelease.revision}</h3>
        <p>{copy.texts.text_3}</p>
        <span class="availability-status">{copy.texts.beschriftung_2} {packSize(packRelease.java.bytes)}</span>
      </a>

      <a class="download-card download-card-active download-card-purple" href={packRelease.bedrock.url} download>
        <span class="availability-icon">◌</span>
        <span class="phase-label">{copy.texts.beschriftung_3}</span>
        <h3>{copy.texts.titel_4} {packRelease.revision}</h3>
        <p>{copy.texts.text_4}</p>
        <span class="availability-status">{copy.texts.beschriftung_4} {packSize(packRelease.bedrock.bytes)}</span>
      </a>

      <a class="download-card" href="#vip-shop">
        <span class="availability-icon">✦</span>
        <h3>{copy.texts.titel_5}</h3>
        <p>{copy.texts.text_5}</p>
        <span class="availability-status">{copy.texts.beschriftung_5}</span>
      </a>
    </div>

    <div class="download-extras" aria-labelledby="download-extras-title">
      <h3 id="download-extras-title">{copy.texts.titel_6}</h3>
      <p class="download-extras-intro">{copy.texts.text_6}</p>

      <details class="download-disclosure">
        <summary><span>{copy.texts.beschriftung_6}</span><span class="download-chevron" aria-hidden="true"></span></summary>
        <div class="download-disclosure-content">
          <p>{copy.texts.text_7}</p>
          <a class="download-extra-link download-extra-primary" href={packRelease.bundle.url} download>{copy.texts.beschriftung_7} <span>{packSize(packRelease.bundle.bytes)} ↓</span></a>
          <div class="download-extra-links">
            <a href={packRelease.installation}>{copy.texts.beschriftung_8}</a>
            <a href={packRelease.report}>{copy.texts.beschriftung_9}</a>
          </div>
        </div>
      </details>

      <details class="download-disclosure">
        <summary><span>{copy.texts.beschriftung_10}</span><span class="download-chevron" aria-hidden="true"></span></summary>
        <div class="download-disclosure-content">
          <p>{copy.texts.text_8}</p>
          <div class="download-extra-links">
            <a href={packRelease.overlay} download>{copy.texts.beschriftung_11} {packRelease.revision} ↓</a>
            <a href={packRelease.mappings} download>{copy.texts.beschriftung_12} {packRelease.revision} ↓</a>
            <a href={packRelease.handoff}>{copy.texts.beschriftung_13}</a>
            <a href={packRelease.preview} download>{copy.texts.beschriftung_14}</a>
          </div>
          <p class="download-extra-note">{copy.texts.text_9}</p>
        </div>
      </details>

      <details class="download-disclosure">
        <summary><span>{copy.texts.beschriftung_15}</span><span class="download-chevron" aria-hidden="true"></span></summary>
        <div class="download-disclosure-content">
          <p>{copy.texts.text_10}</p>
          <div class="download-extra-links">
            <a href={packRelease.java.versionedUrl} download>{copy.texts.beschriftung_16}</a>
            <a href={packRelease.java.originalUrl} download>{copy.texts.beschriftung_17}</a>
            <a href={packRelease.checksums}>{copy.texts.beschriftung_18}</a>
          </div>
          <dl class="download-checksums">
            <div><dt>{copy.texts.beschriftung_19}</dt><dd><code>{packRelease.java.sha256}</code></dd></div>
            <div><dt>{copy.texts.beschriftung_20}</dt><dd><code>{packRelease.bedrock.sha256}</code></dd></div>
          </dl>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .download-extras { margin-top: 1.75rem; }
  .download-extras h3 { margin: 0 0 .55rem; font-family: 'Press Start 2P', ui-monospace, monospace; font-size: .8rem; font-weight: 400; line-height: 1.8; color: #e6dbf0; }
  .download-extras-intro { margin: 0 0 1rem; color: var(--muted); font-size: .85rem; }
  .download-disclosure { border: 1px solid var(--line); border-radius: 8px; background: rgba(24, 18, 36, .92); overflow: hidden; }
  .download-disclosure + .download-disclosure { margin-top: .6rem; }
  .download-disclosure summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.2rem; cursor: pointer; list-style: none; color: #f0e7f8; font-family: Inter, sans-serif; font-size: .9rem; font-weight: 600; line-height: 1.6; }
  .download-disclosure summary > span:first-child { color: inherit; font-size: inherit; }
  .download-disclosure summary::-webkit-details-marker { display: none; }
  .download-disclosure summary::marker { content: ''; }
  .download-disclosure summary:hover { background: rgba(171, 123, 239, .07); }
  .download-disclosure summary:focus-visible { outline-offset: -4px; }
  .download-chevron { flex: 0 0 8px; width: 8px; height: 8px; border-right: 2px solid var(--peace); border-bottom: 2px solid var(--peace); transform: rotate(45deg); margin: -4px 2px 0 0; }
  .download-disclosure[open] .download-chevron { transform: rotate(225deg); margin-top: 4px; }
  .download-disclosure[open] summary { border-bottom: 1px solid var(--line); }
  .download-disclosure-content { padding: 1.1rem 1.2rem 1.3rem; font-size: .85rem; line-height: 1.75; }
  .download-disclosure-content p { margin: 0 0 1rem; max-width: 55rem; color: var(--muted); }
  .download-extra-link { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .8rem 1rem; border: 1px solid rgba(243, 184, 97, .3); border-radius: 5px; color: var(--peace); background: rgba(243, 184, 97, .06); font-weight: 600; }
  .download-extra-link span { white-space: nowrap; font-size: .78rem; }
  .download-extra-links { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; margin-top: .9rem; }
  .download-extra-links a { color: #ddc4f5; text-decoration: underline; text-underline-offset: 4px; }
  .download-extra-links a:hover { color: var(--peace); }
  .download-disclosure-content .download-extra-note { margin: 1rem 0 0; font-size: .78rem; }
  .download-checksums { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1.2rem 0 0; }
  .download-checksums > div { min-width: 0; padding: .85rem; border: 1px solid var(--line); border-radius: 5px; background: rgba(43, 34, 58, .65); }
  .download-checksums dt { color: var(--muted); font-size: .75rem; margin-bottom: .5rem; }
  .download-checksums dd { margin: 0; }
  .download-checksums code { display: block; overflow-wrap: anywhere; color: #e7d9f2; font-size: .72rem; line-height: 1.8; }
  @media (max-width: 600px) {
    .download-disclosure summary { padding: .9rem 1rem; font-size: .85rem; }
    .download-disclosure-content { padding: 1rem; }
    .download-extra-link { align-items: flex-start; flex-direction: column; gap: .3rem; }
    .download-extra-links { flex-direction: column; gap: .7rem; }
    .download-checksums { grid-template-columns: minmax(0, 1fr); }
  }
</style>
