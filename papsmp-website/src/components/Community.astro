---
import copy from '../content/editor/community.json';
---
<section id="community" class="section section-community" aria-labelledby="community-title"><div class="container section-block community-block"><div class="community-grid"><div class="community-copy"><p class="kicker">{copy.texts.text_1}</p><h2 id="community-title">{copy.texts.titel_1}<br /><em>{copy.texts.titel_2}</em></h2><p>{copy.texts.text_2}</p><a class="button button-muted" href="https://discord.gg/hxgnJNTp4J" target="_blank" rel="noreferrer">{copy.texts.beschriftung_1} <span>↗</span></a></div><div class="scene-panel"><img src={copy.images.bild_1} alt={copy.images.bild_1_alt} width="1671" height="941" loading="lazy" /><div class="scene-panel-content"><span class="block-label">{copy.texts.beschriftung_2}</span><p>{copy.texts.text_3}</p></div></div></div></div></section>
