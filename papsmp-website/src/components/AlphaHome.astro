---
import {site} from '../data/site';
import {alpha} from '../data/alpha';
import {faqs} from '../data/faq';
import {packRelease,packSize} from '../data/pack-release';
import AssetImage from './AssetImage.astro';
import AssetEmote from './AssetEmote.astro';
import AlphaShop from './AlphaShop.astro';
---
<main id="main">
  <section class="alpha-wrap alpha-hero" aria-labelledby="hero-title">
    <div class="alpha-hero-copy"><p class="alpha-eyebrow">■ Deutsches Minecraft SMP · von yuuh92</p><h1 id="hero-title">Tagsüber bauen.<br/><em>Nachts bestehen.</em></h1><p class="alpha-hero-lead">Such dir einen Bauplatz. Bring deine Freunde mit. Und überleg dir, wie ihr durch die nächste Purge kommt.</p><div class="alpha-actions"><a class="alpha-btn" href={site.links.discord} target="_blank" rel="noopener noreferrer">Alpha auf Discord verfolgen ↗</a><a class="alpha-link" href="#konzept">Das Spielprinzip ↓</a></div><div class="alpha-launch"><span class="alpha-pill">ALPHA</span><div><strong>{alpha.dateStatus}: <time datetime={alpha.dateISO}>{alpha.date}</time></strong><small>Geplanter Termin · Änderungen auf Discord</small></div></div></div>
    <figure class="alpha-hero-scene"><AssetImage name="alpha-camp" alt="Yuuh als Skeleton und PAP an einem kleinen Minecraft-Bauplatz mit Werkbank." eager={true}/><figcaption><span>01 / Der Anfang</span>Eine Base wird nicht an einem Abend fertig.</figcaption><div class="alpha-scene-stamp" aria-hidden="true">PAP<br/><span>SMP</span></div></figure>
  </section>
  <div class="alpha-wrap alpha-facts"><span><b>Java</b>Minecraft 1.21.11</span><span><b>Peace & Purge</b>Zwei Phasen, eine Welt</span><span><b>Kleine Alpha</b>Bis zu 20 Spieler gleichzeitig</span><a href="/infobuch/">Alles im Infobuch →</a></div>
  <section class="alpha-wrap alpha-section" id="konzept" aria-labelledby="concept-title"><div class="alpha-section-head"><div><p class="alpha-eyebrow">01 / Das Spielprinzip</p><h2 id="concept-title">Deine Base braucht einen Plan.</h2></div><p>Bei PAP SMP gehören Aufbauen und Verteidigen zusammen. Die Phase entscheidet, was gerade möglich ist.</p></div><div class="alpha-phase-grid">
    <article class="alpha-phase"><div class="alpha-image-shell"><AssetImage name="peace-build" alt="Yuuh baut mit PAP an einem Holzhaus zwischen Feldern und Fluss."/><span class="alpha-image-tag">☀ Peace</span></div><div class="alpha-card-copy"><h3>Zeit für den Aufbau</h3><p>Baue, erkunde und handle. Claims schützen deine Base und Kisten vor fremden Zugriffen. Normales Survival-PvP ist ausgeschaltet.</p><a class="alpha-link" href="/infobuch/#claims">So funktionieren Claims →</a></div></article>
    <article class="alpha-phase alpha-purge"><div class="alpha-image-shell"><AssetImage name="purge-night" alt="Yuuh und PAP stehen nachts auf einer Minecraft-Brücke vor ihrer Siedlung."/><span class="alpha-image-tag">☾ Purge</span></div><div class="alpha-card-copy"><h3>Jetzt wird es riskant</h3><p>PvP wird aktiv, Claims sind offen. Bases können angegriffen und Kisten geplündert werden. Wer vorbereitet ist, hat mehr Optionen.</p><a class="alpha-link" href="/infobuch/#phasen">Die Purge nachlesen →</a></div></article>
  </div><p class="alpha-inline-note">Alpha-Konzept: Zeiten und Ausnahmen werden vor der Öffnung bestätigt. Im Spiel zeigt <code>/pap status</code> die aktuelle Phase.</p></section>
  <section class="alpha-wrap alpha-section alpha-book-promo" aria-labelledby="books-title"><div><p class="alpha-eyebrow">02 / Gut vorbereitet</p><h2 id="books-title">Zwei Bücher für deinen Einstieg.</h2><p>Was bietet der Server? Wie funktionieren Herzen, Homes und Shards? Und welche Regeln gelten zwischen zwei Purge-Nächten?</p><div class="alpha-book-links"><a href="/infobuch/"><span aria-hidden="true">▤</span><div><strong>Das Infobuch</strong><small>12 Kapitel · Systeme, Einstieg & Befehle</small></div><b aria-hidden="true">↗</b></a><a href="/regelbuch/"><span aria-hidden="true">▥</span><div><strong>Das Regelbuch</strong><small>6 Kapitel · Entwurf für die Alpha</small></div><b aria-hidden="true">↗</b></a></div></div><div class="alpha-book-visual"><AssetImage name="pack-workbench" alt="PAP neben einem offenen Buch auf einer Minecraft-Werkbank."/><AssetEmote name="pap-curious"/></div></section>
  <section class="alpha-wrap alpha-section" aria-labelledby="features-title"><div class="alpha-section-head"><div><p class="alpha-eyebrow">03 / Dein Spielabend</p><h2 id="features-title">Es gibt immer etwas zu tun.</h2></div><p>Starte mit einem kleinen Bauplatz. Der Rest entsteht, wenn ihr zusammen spielt.</p></div><div class="alpha-feature-grid"><a href="/infobuch/#reisen"><span class="alpha-feature-number">01</span><h3>Zusammen losziehen</h3><p>Teams, Homes und Teleport-Anfragen bringen euch an denselben Ort.</p><span class="alpha-link">Reisen & Teams →</span></a><a href="/infobuch/#handel"><span class="alpha-feature-number">02</span><h3>Beute zu Vorräten machen</h3><p>Verkaufe Fundstücke, handle mit Spielern und nutze Shards für Verträge.</p><span class="alpha-link">Wirtschaft →</span></a><a href="/infobuch/#aufgaben"><span class="alpha-feature-number">03</span><h3>Ein nächstes Ziel finden</h3><p>Aufträge, gemeinsame Projekte und Ereignisse ergänzen den Baualltag.</p><span class="alpha-link">Aufgaben →</span></a></div></section>
  <section class="alpha-wrap alpha-section alpha-join" id="zugang" aria-labelledby="join-title"><div class="alpha-section-head"><div><p class="alpha-eyebrow">04 / Dabei sein</p><h2 id="join-title">Komm zur Alpha dazu.</h2></div><AssetEmote name="yuuh-ready"/></div><div class="alpha-join-grid"><ol class="alpha-steps"><li><span>1</span><div><h3>Discord öffnen</h3><p>Dort findest du Anmeldung, Änderungen und Hilfe vom Team.</p></div></li><li><span>2</span><div><h3>Regeln lesen & Zugang klären</h3><p>Die Alpha nutzt eine Whitelist. Ein Discord-Beitritt schaltet dich nicht automatisch frei.</p></div></li><li><span>3</span><div><h3>Zum Start verbinden</h3><p>Nach Freischaltung kannst du die Java-Adresse verwenden. Prüfe die aktuellen Hinweise vor dem Verbinden.</p></div></li></ol><div class="alpha-server-card"><span class="alpha-label">Java · Minecraft 1.21.11</span><h3>Deine Serveradresse</h3><code id="java-address">{site.server.java}</code><button type="button" class="alpha-btn alpha-btn-secondary" data-alpha-copy={site.server.java}>Adresse kopieren ⧉</button><p role="status" aria-live="polite" class="alpha-copy-status"></p><div class="alpha-bedrock"><strong>Bedrock / Geyser</strong><p>Der Zugang wird noch geprüft. Die Adresse folgt nach dem Verbindungstest.</p></div><a class="alpha-link" href={site.links.discord} target="_blank" rel="noopener noreferrer">Zur Anmeldung auf Discord ↗</a></div></div><aside class="alpha-notice"><strong>Eine Alpha ist ein Teststand.</strong><p>Geplant ab {alpha.date}. Funktionen und Balance können sich ändern. Testdaten können zurückgesetzt werden; ein dauerhafter Erhalt deiner Welt oder Fortschritte ist noch nicht zugesichert.</p></aside></section>
  <section class="alpha-wrap alpha-section" id="downloads" aria-labelledby="availability-title"><div class="alpha-section-head"><div><p class="alpha-eyebrow">05 / Die PAP-Darstellung</p><h2 id="availability-title">Packs für deinen Client.</h2></div><p>{packRelease.label} · Ressourcenstand {packRelease.revision}<br/>Wähle die Datei für deine Edition.</p></div><div class="alpha-download-grid"><article><span class="alpha-label">Java Edition</span><h3>Minecraft 1.21.11</h3><p>Das Java-Pack mit eigenen Texturen und Menüs für PAP SMP.</p><a class="alpha-btn" href={packRelease.java.url} download>Java-Pack herunterladen ↓</a><small>ZIP · {packSize(packRelease.java.bytes)}</small></article><article><span class="alpha-label">Bedrock Edition</span><h3>Bedrock Resource Pack</h3><p>Die Datei zum Testen. Sie bestätigt keinen freigegebenen Serverzugang.</p><a class="alpha-btn alpha-btn-secondary" href={packRelease.bedrock.url} download>Bedrock-Pack herunterladen ↓</a><small>MCPACK · {packSize(packRelease.bedrock.bytes)}</small></article></div><details class="alpha-download-details"><summary>Installation, Prüfsummen & weitere Dateien</summary><div class="alpha-download-links"><a href={packRelease.installation}>Installationshinweise</a><a href={packRelease.checksums}>SHA-256-Prüfsummen</a><a href={packRelease.bundle.url}>Gesamtpaket · {packSize(packRelease.bundle.bytes)}</a><a href={packRelease.java.versionedUrl}>Java-Datei mit Versionsnamen</a><a href={packRelease.overlay}>Geyser-Overlay</a><a href={packRelease.mappings}>Custom Mappings</a><a href={packRelease.travel}>Travel-Menü</a><a href={packRelease.preview}>Icon-Vorschau</a><a href={packRelease.handoff}>Event-UI-Handoff</a><a href={packRelease.report}>Prüfbericht</a><a href={packRelease.java.originalUrl}>Java-Archivstand 3.2.8</a></div><p>Die native Sichtprüfung im Spiel steht noch aus. Java-Event-Icons benötigen das Event-UI-Datapack; Bedrock-Formularbilder werden über Geyser/Floodgate eingebunden.</p></details></section>
  <section class="alpha-wrap alpha-section" id="shop" aria-labelledby="shop-title"><div class="alpha-section-head"><div><p class="alpha-eyebrow">06 / Für die Alpha geplant</p><h2 id="shop-title">VIP, Shards & Keys.</h2></div><p>Die gewünschten Angebote stehen fest. Kaufanbindung und Bedingungen werden vor der Shopöffnung ergänzt.</p></div><AlphaShop/></section>
  <section class="alpha-wrap alpha-section alpha-community" id="community" aria-labelledby="community-title"><div class="alpha-community-art"><AssetImage name="community-lodge" alt="Yuuh und PAP sitzen am Lagerfeuer vor einer kleinen Minecraft-Hütte."/></div><div class="alpha-community-copy"><p class="alpha-eyebrow">07 / Yuuh & PAP</p><h2 id="community-title">Ein Treffpunkt für eure Runde.</h2><p>Ich baue PAP SMP als kleine Alpha auf. Bring Ideen mit, probier die Systeme aus und sag mir, wo etwas hakt.</p><p>Auf Discord sammeln wir die Rückmeldungen und halten euch über den Start auf dem Laufenden. PAP hilft dir hier bei den häufigsten Fragen.</p><a class="alpha-btn" href={site.links.discord} target="_blank" rel="noopener noreferrer">Im Discord vorbeischauen ↗</a><div class="alpha-duo"><AssetEmote name="yuuh-cheer" animated={true}/><AssetEmote name="pap-wave" animated={true}/><span>yuuh92 & PAP</span></div></div></section>
  <section class="alpha-wrap alpha-section alpha-faq" id="faq" aria-labelledby="faq-title"><div class="alpha-section-head"><div><p class="alpha-eyebrow">08 / Noch eine Frage?</p><h2 id="faq-title">Kurz nachschlagen.</h2></div><p>Mehr Details stehen in den Büchern. Bei persönlichen Anliegen hilft der Support.</p></div><div class="alpha-faq-list">{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div><p class="alpha-support">Du brauchst Hilfe? <a href="/kontakt/">Schreib uns →</a> oder öffne den PAP-Helfer am Bildschirmrand.</p></section>
</main>
<script>
  document.querySelector<HTMLButtonElement>('[data-alpha-copy]')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;const status=document.querySelector<HTMLElement>('.alpha-copy-status');try{await navigator.clipboard.writeText(button.dataset.alphaCopy??'');if(status)status.textContent='Adresse kopiert.';}catch{if(status)status.textContent='Bitte markiere die Adresse und kopiere sie manuell.';}});
</script>
