---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/alpha-v2.css';
import '../styles/classic-alpha.css';
import PapHelper from '../components/PapHelper.astro';
import {legal} from '../data/legal';
const { title = 'PAP SMP — Survival mit Peace am Tag und Purge in der Nacht', description = 'Deutscher Minecraft-Survival-Server in der Alpha: Infos zu Spielprinzip, Zugang, Plattformen und Downloads.', canonical = new URL(Astro.url.pathname, Astro.site).href, noindex = !legal.approved } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#12101d" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="PAP SMP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://papsmp.de/alpha-v2/social.jpg" />
    <meta property="og:image:alt" content="PAP SMP — Peace am Tag, Purge in der Nacht" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://papsmp.de/alpha-v2/social.jpg" />
    <title>{title}</title>
  </head>
  <body class="alpha-site classic-site">
    <div class="site-background" aria-hidden="true">
      <video class="site-background-video" autoplay muted loop playsinline preload="metadata" tabindex="-1">
        <source src="/video/pap-alpha-teaser-v023-720p.mp4" type="video/mp4" media="(max-width: 767px)" />
        <source src="/video/pap-alpha-teaser-v023-1080p.mp4" type="video/mp4" />
      </video>
    </div>
    <slot />
    <PapHelper />
    <script>
      const backgroundVideo = document.querySelector('.site-background-video') as HTMLVideoElement | null;
      if (backgroundVideo) {
        backgroundVideo.defaultPlaybackRate = 0.75;
        backgroundVideo.playbackRate = 0.75;
      }
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      const syncBackgroundMotion = () => {
        if (!backgroundVideo) return;
        if (motionPreference.matches) {
          backgroundVideo.pause();
          return;
        }
        void backgroundVideo.play().catch(() => {});
      };
      syncBackgroundMotion();
      motionPreference.addEventListener('change', syncBackgroundMotion);
    </script>
  </body>
</html>
