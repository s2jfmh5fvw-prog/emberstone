{
  "name": "emberstone",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp index.html styles.css dist/ && cp -r assets dist/",
    "dev:pages": "wrangler pages dev dist",
    "publish:pages": "wrangler pages publish dist --project-name emberstone",
    "dev:worker": "wrangler dev",
    "publish:worker": "wrangler publish"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
